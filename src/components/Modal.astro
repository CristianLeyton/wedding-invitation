---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<dialog
  id={id}
  class="payment-modal fixed inset-0 m-auto w-[min(100%-2rem,32rem)] max-h-[90dvh] overflow-y-auto border border-primary bg-bgwhite text-primary p-0 backdrop:bg-primary/60 open:animate-[modal-fade-in_0.2s_ease-out]"
  aria-labelledby={`${id}-title`}
>
  <div class="corner-shape p-6 md:p-8">
    <div class="flex items-start justify-between gap-4 mb-4">
      <h2
        id={`${id}-title`}
        class="text-2xl lg:text-3xl font-bold italic"
      >
        {title}
      </h2>
      <button
        type="button"
        class="modal-close shrink-0 size-8 flex items-center justify-center rounded-full border border-primary hover:bg-primary hover:text-bgwhite transition-colors cursor-pointer"
        aria-label="Cerrar"
      >
        <span aria-hidden="true">&times;</span>
      </button>
    </div>
    <slot />
  </div>
</dialog>

<style>
  .corner-shape {
    border-radius: 18px;
    corner-shape: scoop;
  }

  @keyframes modal-fade-in {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .payment-modal::backdrop {
    background: rgb(54 13 19 / 0.6);
  }
</style>
