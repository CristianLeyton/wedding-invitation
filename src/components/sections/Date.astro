---
import CalendarIcon from "../icons/calendarIcon.astro";
import Counter from "../Counter.astro";
import firstImageDesktop from "../../assets/images/firts_image_desktop_2.webp";
import firstImageMobile from "../../assets/images/firts_image_mobile_2.webp";
import semicirculo from "../../assets/images/semicirculo.png";
import semicirculoMobile from "../../assets/images/semicirculo_mobile.png";
---

<section class="bg-bgwhite h-svh overflow-hidden p-12 lg:p-0 relative z-0">
  <div
    class="text-white container mx-auto flex flex-col items-center justify-end h-full"
  >
    <picture class="w-full h-full object-cover absolute inset-0 card -z-10">
      <source srcset={firstImageDesktop.src} media="(min-width: 1024px)" />
      <source srcset={firstImageMobile.src} media="(max-width: 1024px)" />
      <img
        src={firstImageDesktop.src}
        alt="First image"
        class="w-full h-full object-cover"
      />
    </picture>
    <div
      class="absolute inset-0 bg-[linear-gradient(180deg,transparent_30%,#360d13_100%)]"
    >
    </div>

    <div class="text-center lg:mb-16 card">
      <p class="italic text-lg lg:text-xl 2xl:text-2xl">Brenda y Carlos</p>
      <p class="font-bold text-4xl md:text-5xl lg:text-6xl 2xl:text-7xl">
        ¡Nos casamos!
      </p>
    </div>
  </div>
</section>

<section class="bg-primary h-fit py-5 relative">
  <!--  bg-[linear-gradient(180deg,#f9f1e6_0%,#f9f1e6_60%,transparent_70%)] semicircle -->

  <picture class="">
    <source srcset={semicirculo.src} media="(min-width: 620px)" />
    <source srcset={semicirculoMobile.src} media="(max-width: 620px)" />
    <img
      src={semicirculo.src}
      alt="semicirculo"
      class="w-full h-full object-cover absolute inset-0 card z-10"
    />
  </picture>

  <div
    class="text-center p-4 sm:p-6 lg:p-4 2xl:p-6 text-primary flex flex-col items-center justify-start"
  >
    <CalendarIcon
      class="size-5 md:size-7 lg:size-5 2xl:size-7 mx-auto relative z-10"
    />
    <p class="text-lg font-bold lg:text-2xl relative z-10">
      9 de Enero - 17:00hs
    </p>
    <div
      class="bg-primary text-white rounded-full px-3 py-1 text-xs z-30 md:text-sm md:px-4 md:py-2 hover:bg-primary/80 transition-colors w-fit my-1 md:my-4"
      id="calendar-button"
    >
      <a
        id="google-calendar-btn"
        href="https://www.google.com/calendar/render?action=TEMPLATE&text=Boda%20de%20Brenda%20y%20Carlos&dates=20270109T170000/20270110T010000&details=Matrimonio%20de%20Brenda%20y%20Carlos%0A%0AUbicaci%C3%B3n%20en%20Google%20Maps%3A%20https%3A%2F%2Fmaps.app.goo.gl%2FcEvjUNLggCzxE9V87&location=Finca%20El%20Milagro%2C%20Salta%2C%20Argentina"
        target="_blank"
        rel="noopener noreferrer"
      >
        AGENDAR FECHA
      </a>
      <a
        id="apple-calendar-btn"
        href="data:text/calendar;charset=utf-8,BEGIN:VCALENDAR%0AVERSION:2.0%0ABEGIN:VEVENT%0ASUMMARY:Boda%20de%20Brenda%20y%20Carlos%0ADTSTART:20270109T170000%0ADTEND:20270110T010000%0ADESCRIPTION:Matrimonio%20de%20Brenda%20y%20Carlos.%5Cn%5CnGoogle%20Maps%3A%20https%3A%2F%2Fmaps.app.goo.gl%2FcEvjUNLggCzxE9V87%0ALOCATION:Finca%20El%20Milagro%2C%20Salta%2C%20Argentina%0AGEO:-24.8962259;-65.6054632%0AEND:VEVENT%0AEND:VCALENDAR"
        download="boda-brenda-carlos.ics"
        class="hidden"
      >
        AGENDAR FECHA
      </a>
    </div>

    <Counter />
  </div>
</section>
