---
import Modal from "../Modal.astro";

const TRANSFER_ALIAS = "brendaycarlos2027";
---

<section class="bg-primary text-bgwhite leading-relaxed text-pretty w-full">
  <div class="card">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320" class="-mb-0.5">
      <path
        fill="#f9f1e6"
        fill-opacity="1"
        d="M0,288L60,261.3C120,235,240,181,360,186.7C480,192,600,256,720,240C840,224,960,128,1080,122.7C1200,117,1320,203,1380,245.3L1440,288L1440,320L1380,320C1320,320,1200,320,1080,320C960,320,840,320,720,320C600,320,480,320,360,320C240,320,120,320,60,320L0,320Z"
      ></path>
    </svg>

    <div class="bg-bgwhite text-primary">
      <div
        class="container mx-auto px-6 gap-8 flex flex-col justify-center items-center card pb-8"
      >
        <h2
          class="text-4xl lg:text-5xl 2xl:text-6xl font-bold italic text-center"
        >
          ¿Querés hacernos un regalo?
        </h2>

        <p class="text-center text-base lg:text-lg 2xl:text-xl mb-1">
          No es necesario traer un obsequio para celebrar con nosotros; tu
          compañía ya es un <span class="italic font-bold">inmenso regalo.</span
          > Sin embargo, si deseás bendecir el inicio de nuestro hogar, podrás elegir
          entre nuestra lista de regalos o realizar un aporte para ayudarnos a construir
          este <span class="italic font-bold">nuevo capítulo.</span>
        </p>

        <div class="grid grid-cols-2 gap-8">
          <button
            type="button"
            class="px-4 py-2 bg-primary text-bgwhite hover:bg-primary/80 transition text-xl 2xl:text-3xl cursor-pointer"
          >
            Lista de regalos
          </button>

          <button
            type="button"
            data-modal-target="modal-aporte"
            class="px-4 py-2 bg-primary text-bgwhite hover:bg-primary/80 transition text-xl 2xl:text-3xl cursor-pointer"
          >
            Hacer un aporte
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<Modal id="modal-aporte" title="Hacer un aporte">
  <p class="text-base lg:text-lg mb-6">
    Si querés bendecir el inicio de nuestro hogar, podés realizar un aporte
    mediante <span class="font-bold italic">transferencia bancaria</span> al
    siguiente alias:
  </p>
  <div
    class="flex items-center justify-between gap-3 border border-primary rounded-xl p-4"
  >
    <span
      id="gift-transfer-alias"
      class="text-xl lg:text-2xl font-bold font-sans break-all"
    >
      {TRANSFER_ALIAS}
    </span>
    <button
      type="button"
      data-copy-btn
      data-copy-source="gift-transfer-alias"
      data-copy-label="Copiar"
      class="shrink-0 border border-primary px-4 py-2 text-sm font-bold hover:bg-primary hover:text-bgwhite transition-colors cursor-pointer rounded-lg"
    >
      Copiar
    </button>
  </div>
</Modal>

<script>
  let lastTrigger: HTMLButtonElement | null = null;

  function isPlanAvailableClient(deadlineIso: string): boolean {
    const deadline = new Date(deadlineIso);
    const now = new Date();
    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    const limit = new Date(
      deadline.getFullYear(),
      deadline.getMonth(),
      deadline.getDate(),
    );
    return today <= limit;
  }

  function updateInstallmentPlans() {
    const plans = document.querySelectorAll<HTMLLIElement>(".installment-plan");
    let visibleCount = 0;

    plans.forEach((plan) => {
      const deadline = plan.dataset.deadline;
      if (!deadline) return;

      const available = isPlanAvailableClient(deadline);
      plan.hidden = !available;
      if (available) visibleCount += 1;
    });

    const noPlansMessage = document.getElementById("no-plans-message");
    if (noPlansMessage) {
      noPlansMessage.hidden = visibleCount > 0;
    }
  }

  function setupModals() {
    const triggers = document.querySelectorAll<HTMLButtonElement>(
      "[data-modal-target]",
    );

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const modalId = trigger.dataset.modalTarget;
        if (!modalId) return;

        const modal = document.getElementById(
          modalId,
        ) as HTMLDialogElement | null;
        if (!modal) return;

        lastTrigger = trigger;
        modal.showModal();
      });
    });

    document
      .querySelectorAll<HTMLDialogElement>(".payment-modal")
      .forEach((modal) => {
        modal.addEventListener("click", (event) => {
          const rect = modal.getBoundingClientRect();
          const isBackdropClick =
            event.clientX < rect.left ||
            event.clientX > rect.right ||
            event.clientY < rect.top ||
            event.clientY > rect.bottom;

          if (isBackdropClick) {
            modal.close();
          }
        });

        modal.addEventListener("close", () => {
          lastTrigger?.focus();
          lastTrigger = null;
        });

        modal.querySelector(".modal-close")?.addEventListener("click", () => {
          modal.close();
        });
      });

    const copyBtn = document.getElementById("copy-alias-btn");
    const aliasEl = document.getElementById("transfer-alias");

    copyBtn?.addEventListener("click", async () => {
      const alias = aliasEl?.textContent?.trim();
      if (!alias) return;

      try {
        await navigator.clipboard.writeText(alias);
        copyBtn.textContent = "¡Copiado!";
        setTimeout(() => {
          copyBtn.textContent = "Copiar";
        }, 2000);
      } catch {
        copyBtn.textContent = "Error";
        setTimeout(() => {
          copyBtn.textContent = "Copiar";
        }, 2000);
      }
    });

    document.querySelectorAll<HTMLButtonElement>("[data-copy-btn]").forEach((btn) => {
      if (btn.id === "copy-alias-btn") return;

      btn.addEventListener("click", async () => {
        const sourceId = btn.dataset.copySource;
        if (!sourceId) return;

        const sourceEl = document.getElementById(sourceId);
        const text = sourceEl?.textContent?.trim();
        if (!text) return;

        const defaultLabel = btn.dataset.copyLabel ?? "Copiar";

        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = "¡Copiado!";
          setTimeout(() => {
            btn.textContent = defaultLabel;
          }, 2000);
        } catch {
          btn.textContent = "Error";
          setTimeout(() => {
            btn.textContent = defaultLabel;
          }, 2000);
        }
      });
    });

    updateInstallmentPlans();
  }

  setupModals();
</script>